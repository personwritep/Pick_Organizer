        monitor.disconnect();

        let disp=document.createElement("div");
        disp.setAttribute("id", "disp_po");
        disp.innerHTML=
            '　　■エリア指定：空白行を Ctrl+Click　'+
            '■Cardをエリアに配置/除外：Alt+Click</span>'+
